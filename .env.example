# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Email delivery
# Choose backend: "sendgrid" (default) or "gmail"
DIGEST_EMAIL_BACKEND=sendgrid
DIGEST_FROM=spin-control@getlivewire.com
DIGEST_TO=henry@getlivewire.com

# SendGrid (when DIGEST_EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=

# Gmail API (when DIGEST_EMAIL_BACKEND=gmail)
# Path to OAuth credentials JSON and stored token JSON
GMAIL_CREDENTIALS_PATH=gmail_credentials.json
GMAIL_TOKEN_PATH=gmail_token.json

# NewsAPI (optional - if absent, ingestion runs RSS-only)
NEWSAPI_KEY=

# Database (sqlite file path)
SPIN_CONTROL_DB=spin_control.db
